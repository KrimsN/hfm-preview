{
  "name": "hfm-preview",
  "displayName": "Markdown Preview for Habr",
  "description": "Превью статьи в том виде, в каком её отрисует Хабр, и диагностика неподдерживаемых конструкций",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "publisher": "krimsn",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "hfm",
        "aliases": [
          "Habr Flavored Markdown",
          "HFM"
        ],
        "extensions": [
          ".habr.md"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hfm",
        "scopeName": "text.html.hfm",
        "path": "./syntaxes/hfm.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "hfm.openPreview",
        "title": "Открыть превью (Habr)",
        "category": "HFM",
        "icon": "$(open-preview)"
      },
      {
        "command": "hfm.openPreviewToSide",
        "title": "Открыть превью сбоку (Habr)",
        "category": "HFM",
        "icon": "$(open-preview)"
      },
      {
        "command": "hfm.previewThemeLight",
        "title": "Показать в светлой теме",
        "category": "HFM"
      },
      {
        "command": "hfm.previewThemeDark",
        "title": "Показать в тёмной теме",
        "category": "HFM"
      },
      {
        "command": "hfm.previewThemeAuto",
        "title": "Тема как в VS Code",
        "category": "HFM"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "hfm.openPreviewToSide",
          "when": "editorLangId == hfm",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "hfm.openPreview",
          "when": "editorLangId == hfm"
        },
        {
          "command": "hfm.openPreviewToSide",
          "when": "editorLangId == hfm"
        },
        {
          "command": "hfm.previewThemeLight",
          "when": "false"
        },
        {
          "command": "hfm.previewThemeDark",
          "when": "false"
        },
        {
          "command": "hfm.previewThemeAuto",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "hfm.previewThemeDark",
          "when": "webviewId == 'hfm.preview' && webviewSection == 'preview' && hfmTheme == 'light'",
          "group": "hfm@1"
        },
        {
          "command": "hfm.previewThemeLight",
          "when": "webviewId == 'hfm.preview' && webviewSection == 'preview' && hfmTheme == 'dark'",
          "group": "hfm@1"
        },
        {
          "command": "hfm.previewThemeAuto",
          "when": "webviewId == 'hfm.preview' && webviewSection == 'preview' && hfmThemeMode != 'auto'",
          "group": "hfm@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "hfm.openPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == hfm"
      }
    ],
    "configuration": {
      "title": "Markdown Preview for Habr",
      "properties": {
        "hfm.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Показывать предупреждения о конструкциях, которые Хабр не поддерживает или ломает."
        },
        "hfm.preview.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "Как у VS Code",
            "Светлая, как на Хабре",
            "Тёмная, как на Хабре"
          ],
          "default": "auto",
          "description": "Тема превью статьи."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "markdown-it": "^15.0.2",
    "mathjax-full": "^3.2.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.4",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "files": [
    "dist/extension.js",
    "media",
    "syntaxes",
    "language-configuration.json"
  ]
}
