{
  "name": "hfm-preview",
  "displayName": "Markdown Preview for Habr",
  "description": "Превью статьи в том виде, в каком её отрисует Хабр, и диагностика неподдерживаемых конструкций",
  "version": "0.1.3",
  "license": "MIT",
  "publisher": "krimsn",
  "author": {
    "name": "KrimsN",
    "url": "https://github.com/KrimsN"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KrimsN/hfm-preview.git"
  },
  "bugs": {
    "url": "https://github.com/KrimsN/hfm-preview/issues"
  },
  "homepage": "https://github.com/KrimsN/hfm-preview#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f2d3d",
    "theme": "dark"
  },
  "keywords": [
    "habr",
    "хабр",
    "markdown",
    "preview",
    "превью",
    "habr.com",
    "linter"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:hfm.preview"
  ],
  "contributes": {
    "languages": [
      {
        "id": "hfm",
        "aliases": [
          "Habr Flavored Markdown",
          "HFM"
        ],
        "extensions": [
          ".habr.md"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hfm",
        "scopeName": "text.html.hfm",
        "path": "./syntaxes/hfm.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "hfm.openPreview",
        "title": "Открыть превью (Habr)",
        "category": "HFM",
        "icon": "$(open-preview)"
      },
      {
        "command": "hfm.openPreviewToSide",
        "title": "Открыть превью сбоку (Habr)",
        "category": "HFM",
        "icon": "$(open-preview)"
      },
      {
        "command": "hfm.generateToc",
        "title": "Собрать оглавление с якорями",
        "category": "HFM"
      },
      {
        "command": "hfm.insertFrontmatter",
        "title": "Вставить frontmatter статьи",
        "category": "HFM"
      },
      {
        "command": "hfm.goToCover",
        "title": "Открыть КДПВ",
        "category": "HFM"
      },
      {
        "command": "hfm.onEnterKey",
        "title": "Enter в списке: новый пункт",
        "category": "HFM"
      },
      {
        "command": "hfm.onTabKey",
        "title": "Tab в списке: вложить пункт",
        "category": "HFM"
      },
      {
        "command": "hfm.onShiftTabKey",
        "title": "Shift+Tab в списке: поднять пункт",
        "category": "HFM"
      },
      {
        "command": "hfm.previewThemeLight",
        "title": "Показать в светлой теме",
        "category": "HFM"
      },
      {
        "command": "hfm.previewThemeDark",
        "title": "Показать в тёмной теме",
        "category": "HFM"
      },
      {
        "command": "hfm.previewThemeAuto",
        "title": "Тема как в VS Code",
        "category": "HFM"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "hfm.openPreviewToSide",
          "when": "editorLangId == hfm",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "hfm.openPreview",
          "when": "editorLangId == hfm"
        },
        {
          "command": "hfm.openPreviewToSide",
          "when": "editorLangId == hfm"
        },
        {
          "command": "hfm.generateToc",
          "when": "editorLangId == hfm"
        },
        {
          "command": "hfm.insertFrontmatter",
          "when": "editorLangId == hfm"
        },
        {
          "command": "hfm.goToCover",
          "when": "editorLangId == hfm"
        },
        {
          "command": "hfm.onEnterKey",
          "when": "false"
        },
        {
          "command": "hfm.onTabKey",
          "when": "false"
        },
        {
          "command": "hfm.onShiftTabKey",
          "when": "false"
        },
        {
          "command": "hfm.previewThemeLight",
          "when": "false"
        },
        {
          "command": "hfm.previewThemeDark",
          "when": "false"
        },
        {
          "command": "hfm.previewThemeAuto",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "hfm.previewThemeDark",
          "when": "webviewId == 'hfm.preview' && webviewSection == 'preview' && hfmTheme == 'light'",
          "group": "hfm@1"
        },
        {
          "command": "hfm.previewThemeLight",
          "when": "webviewId == 'hfm.preview' && webviewSection == 'preview' && hfmTheme == 'dark'",
          "group": "hfm@1"
        },
        {
          "command": "hfm.previewThemeAuto",
          "when": "webviewId == 'hfm.preview' && webviewSection == 'preview' && hfmThemeMode != 'auto'",
          "group": "hfm@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "hfm.onEnterKey",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == hfm && !editorReadonly && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inSnippetMode"
      },
      {
        "command": "hfm.onTabKey",
        "key": "tab",
        "when": "editorTextFocus && editorLangId == hfm && !editorReadonly && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inSnippetMode && !editorTabMovesFocus && !inlineSuggestionVisible"
      },
      {
        "command": "hfm.onShiftTabKey",
        "key": "shift+tab",
        "when": "editorTextFocus && editorLangId == hfm && !editorReadonly && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inSnippetMode && !editorTabMovesFocus"
      },
      {
        "command": "hfm.openPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == hfm"
      }
    ],
    "configuration": {
      "title": "Markdown Preview for Habr",
      "properties": {
        "hfm.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Показывать предупреждения о конструкциях, которые Хабр не поддерживает или ломает."
        },
        "hfm.diagnostics.typography": {
          "type": "boolean",
          "default": true,
          "description": "Подсказки по типографике Хабра: кавычки, тире, пробелы в числах, даты и т. п. (уровень «подсказка»)."
        },
        "hfm.toc.transliterate": {
          "type": "boolean",
          "default": true,
          "description": "Писать имена якорей латиницей (kak-eto-rabotaet вместо как-это-работает): такие ссылки не превращаются в %D0%BA… при копировании."
        },
        "hfm.preview.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "Как у VS Code",
            "Светлая, как на Хабре",
            "Тёмная, как на Хабре"
          ],
          "default": "auto",
          "description": "Тема превью статьи."
        },
        "hfm.preview.scrollSync": {
          "type": "boolean",
          "default": true,
          "description": "Синхронизировать прокрутку превью и редактора в обе стороны."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies --readme-path README.marketplace.md",
    "host": "npm run build && code --extensionDevelopmentPath=. --new-window"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "markdown-it": "^15.0.2",
    "mathjax-full": "^3.2.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.4",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "files": [
    "dist/extension.js",
    "media",
    "syntaxes",
    "language-configuration.json",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
