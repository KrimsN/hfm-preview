{
  "version": "0.2.0",
  "configurations": [
    {
      // Пересборка в фоне; окно расширения перезагружается само, когда бандл или стили изменились
      "name": "Запуск расширения (живое обновление)",
      "type": "extensionHost",
      "request": "launch",
      "noDebug": true,
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "preLaunchTask": "npm: watch"
    },
    {
      "name": "Запуск расширения (без отладчика)",
      "type": "extensionHost",
      "request": "launch",
      "noDebug": true,
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Запуск расширения (с отладчиком)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    }
  ]
}
